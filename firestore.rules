rules_version = '2';

// Firestore Security Rules for Feast
//   users/{uid}                        profile: owner only
//   users/{uid}/recipes/{id}           recipes: owner only
//   users/{uid}/mealPlanEntries/{id}   meal plan: owner only
//   usernames/{username}               one owner per username
//   ingredients/{ingredientId}         Edwin's data: read only
// Anything not listed is blocked.
service cloud.firestore {
  match /databases/{database}/documents {

    // Is someone logged in?
    function signedIn() {
      return request.auth != null;
    }

    // Is the logged-in user the owner?
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // 3 to 20 lowercase letters, numbers or _
    function validUsername(name) {
      return name is string && name.matches('^[a-z0-9_]{3,20}$');
    }

    // A real date and time, at most 5 minutes in the future
    function validTimestamp(t) {
      return t is int
        && t >= 1577836800000
        && t <= 4133980799999
        && t <= request.time.toMillis() + 300000;
    }

    // A list with no duplicates, only allowed values
    function validChoices(values, allowed, max) {
      return values is list
        && values.size() <= max
        && values.toSet().size() == values.size()
        && values.hasOnly(allowed);
    }

    // Health Canada's 11 allergens
    function allergenList() {
      return ['peanuts', 'tree_nuts', 'milk', 'eggs', 'fish', 'shellfish', 'sesame',
              'soy', 'wheat', 'mustard', 'sulphites'];
    }

    // Allowed diet tags
    function dietTagList() {
      return ['vegan', 'vegetarian', 'pescatarian', 'keto_friendly', 'gluten_free', 'dairy_free'];
    }

    // Meal types a recipe can have
    function recipeMealTypeList() {
      return ['breakfast', 'lunch', 'dinner', 'snack'];
    }

    // Meal planner slots
    function plannerMealTypeList() {
      return ['breakfast', 'lunch', 'dinner'];
    }

    // Document id: lowercase letters, numbers, _ or -
    function validId(id) {
      return id is string && id.matches('^[a-z0-9_-]{1,100}$');
    }

    // Text between min and max characters
    function validText(s, min, max) {
      return s is string && s.matches('(?s).{' + string(min) + ',' + string(max) + '}');
    }

    // A name with safe characters only
    function validName(s, max) {
      return validText(s, 1, max) && s.matches("^[\\p{L}\\p{M}\\p{N} .,'’&()\\-!/%+]+$");
    }

    // A whole number between min and max
    function validInt(n, min, max) {
      return n is int && n >= min && n <= max;
    }

    // A list with min to max items
    function validList(values, min, max) {
      return values is list && values.size() >= min && values.size() <= max;
    }

    // Allergies and diets, or null if not set yet
    function validRestrictions(r) {
      return r == null || (
        r is map
        && r.keys().hasOnly(['allergens', 'diets'])
        && r.keys().hasAll(['allergens', 'diets'])
        && validChoices(r.allergens, allergenList(), allergenList().size())
        && validChoices(r.diets, dietTagList(), dietTagList().size())
      );
    }

    // Profile fields (no email or password)
    function validProfile(p) {
      return p.keys().hasOnly(['username', 'dietaryRestrictions', 'createdAt', 'updatedAt', 'schemaVersion'])
        && p.keys().hasAll(['username', 'dietaryRestrictions', 'createdAt', 'updatedAt', 'schemaVersion'])
        && validUsername(p.username)
        && validRestrictions(p.dietaryRestrictions)
        && validTimestamp(p.createdAt)
        && validTimestamp(p.updatedAt)
        && p.updatedAt >= p.createdAt
        && p.schemaVersion == 1;
    }

    // Last edit wins: an older edit can't replace a newer one
    function notStale() {
      return request.resource.data.updatedAt >= resource.data.updatedAt;
    }

    // Does this user hold this username after the write?
    function nameHeldBy(name, uid) {
      let path = /databases/$(database)/documents/usernames/$(name);
      return existsAfter(path) && getAfter(path).data.uid == uid;
    }

    // Dates and version every saved record needs
    function validRecordFields(d) {
      return validTimestamp(d.createdAt)
        && validTimestamp(d.updatedAt)
        && d.updatedAt >= d.createdAt
        && (!('deletedAt' in d) || validTimestamp(d.deletedAt))
        && d.schemaVersion == 1;
    }

    // createdAt never changes, and a deleted record stays deleted
    function keepsRecordFields() {
      let before = resource.data;
      let after = request.resource.data;
      return after.createdAt == before.createdAt
        && (!('deletedAt' in before) || after.get('deletedAt', null) == before.deletedAt);
    }

    // Recipe fields and limits
    function validRecipe(r) {
      let required = ['title', 'servings', 'mealTypes', 'ingredients', 'steps', 'dietTags',
                      'createdAt', 'updatedAt', 'schemaVersion'];
      let optional = ['description', 'prepTimeMinutes', 'cookTimeMinutes', 'notes',
                      'allergens', 'deletedAt'];
      return r.keys().hasAll(required)
        && r.keys().hasOnly(required.concat(optional))
        && validName(r.title, 100)
        && (!('description' in r) || validText(r.description, 0, 500))
        && validInt(r.servings, 1, 100)
        && (!('prepTimeMinutes' in r) || validInt(r.prepTimeMinutes, 0, 1440))
        && (!('cookTimeMinutes' in r) || validInt(r.cookTimeMinutes, 0, 1440))
        && validChoices(r.mealTypes, recipeMealTypeList(), 4)
        && validList(r.ingredients, 1, 50)
        && validList(r.steps, 1, 50)
        && validChoices(r.dietTags, dietTagList(), 6)
        && (!('notes' in r) || validText(r.notes, 0, 1000))
        && (!('allergens' in r) || validChoices(r.allergens, allergenList(), allergenList().size()))
        && validRecordFields(r);
    }

    // A day that exists (no 30 February)
    function isRealDate(key) {
      let parts = key.split('-');
      let year = int(parts[0]);
      let month = int(parts[1]);
      let day = int(parts[2]);
      let leap = year % 4 == 0 && (year % 100 != 0 || year % 400 == 0);
      let monthLengths = [31, leap ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
      return month >= 1 && month <= 12 && day >= 1 && day <= monthLengths[month - 1];
    }

    // Date as YYYY-MM-DD, 2000 to 2100
    function validDateKey(key) {
      return key is string
        && key.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && key >= '2000-01-01'
        && key <= '2100-12-31'
        && isRealDate(key);
    }

    // Meal plan entry fields and limits
    function validMealPlanEntry(e) {
      let required = ['date', 'mealType', 'recipeId', 'servings', 'createdAt', 'updatedAt',
                      'schemaVersion'];
      return e.keys().hasAll(required)
        && e.keys().hasOnly(required.concat(['deletedAt']))
        && validDateKey(e.date)
        && e.mealType in plannerMealTypeList()
        && validId(e.recipeId)
        && validInt(e.servings, 1, 100)
        && validRecordFields(e);
    }

    // User profiles
    match /users/{uid} {
      // Only the owner can read their profile
      allow get: if isOwner(uid);

      // Created together with the username
      allow create: if isOwner(uid)
        && validProfile(request.resource.data)
        && request.resource.data.dietaryRestrictions == null
        && request.resource.data.updatedAt == request.resource.data.createdAt
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;

      // Username and createdAt never change
      allow update: if isOwner(uid)
        && validProfile(request.resource.data)
        && notStale()
        && request.resource.data.username == resource.data.username
        && request.resource.data.createdAt == resource.data.createdAt;

      // Delete only after the username is released
      allow delete: if isOwner(uid)
        && (resource == null || !nameHeldBy(resource.data.username, uid));

      // The user's recipes: owner only
      match /recipes/{recipeId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && validId(recipeId)
          && validRecipe(request.resource.data);
        allow update: if isOwner(uid)
          && validId(recipeId)
          && validRecipe(request.resource.data)
          && notStale()
          && keepsRecordFields();
      }

      // The user's meal plan: owner only, the recipe can't change
      match /mealPlanEntries/{entryId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && validId(entryId)
          && validMealPlanEntry(request.resource.data);
        allow update: if isOwner(uid)
          && validId(entryId)
          && validMealPlanEntry(request.resource.data)
          && notStale()
          && keepsRecordFields()
          && request.resource.data.recipeId == resource.data.recipeId;
      }
    }

    // Usernames: one owner each
    match /usernames/{username} {
      // Anyone can check one name, nobody can list them all
      allow get: if true;

      // Only if the name is free, one name per user
      allow create: if signedIn()
        && validUsername(username)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;

      // Only the owner can release it
      allow delete: if signedIn()
        && (resource == null || resource.data.uid == request.auth.uid);
    }

    // Ingredients: signed-in users can read, nobody can change them from the app
    match /ingredients/{ingredientId} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
