# Copy this to .env.local (which git ignores) and fill it in. Never commit real values.
# EXPO_PUBLIC_ values are built into the app where anyone can read them, so they must
# never hold a secret. These identify the Firebase project; the Security Rules protect
# the data.

# "memory" (a development fake) or "firebase". An empty value is refused, so to use
# memory, delete this line. Production builds refuse memory.
EXPO_PUBLIC_BACKEND=

# From the Firebase console: Project settings > Your apps > SDK setup and configuration.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
